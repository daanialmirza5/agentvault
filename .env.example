# AgentVault configuration. Copy to `.env` (never commit `.env`).
# Every value has a safe local default; nothing here is required to run the demo.

# --- Backend -----------------------------------------------------------------
# SQLite file used by default. Use an absolute path in production containers.
AGENTVAULT_DATABASE_URL=sqlite:///./data/agentvault.db
# local | test | production. `production` disables the interactive API docs.
AGENTVAULT_ENVIRONMENT=local
# Comma-separated list of origins allowed by CORS (no wildcards).
AGENTVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret. When set, every mutating /api/v1 request must send
# `Authorization: Bearer <token>`. Leave empty for single-user local mode.
AGENTVAULT_API_TOKEN=
# Display name recorded on approval decisions in single-user mode.
AGENTVAULT_OPERATOR_NAME=local-operator

# Resource limits
AGENTVAULT_MAX_REQUEST_BYTES=262144
AGENTVAULT_MAX_STEPS=40
AGENTVAULT_MAX_TOOL_CALLS=20
AGENTVAULT_MAX_IDENTICAL_CALLS=3
AGENTVAULT_APPROVAL_TTL_SECONDS=900
AGENTVAULT_EXECUTION_TIMEOUT_SECONDS=30

# Data retention: executions older than this many days are eligible for
# `python -m app.cli purge`. 0 disables purging.
AGENTVAULT_RETENTION_DAYS=30

# Seed built-in tools, policies and scenarios on startup.
AGENTVAULT_SEED_ON_STARTUP=true

# --- Optional LLM adapter (OpenAI-compatible chat completions API) -----------
# Disabled unless BOTH values are set. When enabled, the task text, tool
# catalogue and tool results of LLM-driven executions are sent to this endpoint.
AGENTVAULT_LLM_BASE_URL=
AGENTVAULT_LLM_API_KEY=
AGENTVAULT_LLM_MODEL=
AGENTVAULT_LLM_TIMEOUT_SECONDS=20
AGENTVAULT_LLM_MAX_RETRIES=2

# --- Frontend (read at build time by Vite) -----------------------------------
# Base URL of the backend API. Empty = same origin (dev proxy / Docker nginx).
VITE_API_BASE_URL=
